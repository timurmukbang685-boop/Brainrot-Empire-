bot.action("admin_requests", async (ctx) => {
  if (!isAdmin(ctx)) return ctx.answerCbQuery("Нет доступа");

  const result = await pool.query(`
    SELECT id, player_name, brainrot, coins
    FROM topup_requests
    WHERE created_at > NOW() - INTERVAL '5 minutes'
    ORDER BY created_at ASC
  `);

  await ctx.answerCbQuery();

  if (!result.rows.length) {
    return ctx.reply("📭 Активных заявок нет.");
  }

  for (const request of result.rows) {
    await ctx.reply(
      "📥 Заявка\n" +
      "Игрок: " + request.player_name + "\n" +
      "Brainrot: " + request.brainrot + "\n" +
      "Монеты: " + request.coins,
      Markup.inlineKeyboard([
        [Markup.button.callback("✅ Подтвердить", "approve_" + request.id)],
        [Markup.button.callback("❌ Отклонить", "reject_" + request.id)]
      ])
    );
  }
});

bot.action("admin_players", async (ctx) => {
  if (!isAdmin(ctx)) return ctx.answerCbQuery("Нет доступа");

  const result = await pool.query(
    "SELECT username, balance FROM players ORDER BY balance DESC LIMIT 30"
  );

  await ctx.answerCbQuery();

  if (!result.rows.length) {
    return ctx.reply("Игроков пока нет.");
  }

  const lines = result.rows.map(
    player => "👤 " + player.username + " — " + player.balance + " монет"
  );

  await ctx.reply("👥 ИГРОКИ\n\n" + lines.join("\n"));
});

bot.action(/^approve_(.+)$/, async (ctx) => {
  if (!isAdmin(ctx)) return ctx.answerCbQuery("Нет доступа");

  const id = ctx.match[1];
  const client = await pool.connect();

  try {
    await client.query("BEGIN");

    const result = await client.query(
      "SELECT * FROM topup_requests WHERE id = $1 FOR UPDATE",
      [id]
    );

    if (!result.rows.length) {
      await client.query("ROLLBACK");
      return ctx.answerCbQuery("Заявка уже обработана");
    }

    const request = result.rows[0];

    if (Date.now() - new Date(request.created_at).getTime() >= 300000) {
      await client.query(
        "DELETE FROM topup_requests WHERE id = $1",
        [id]
      );
      await client.query("COMMIT");
      return ctx.answerCbQuery("Заявка истекла");
    }

    await client.query(
      "UPDATE players SET balance = balance + $1 WHERE id = $2",
      [request.coins, request.player_id]
    );

    await client.query(
      "DELETE FROM topup_requests WHERE id = $1",
      [id]
    );

    await client.query("COMMIT");

    await ctx.answerCbQuery("Монеты начислены!");
    await ctx.editMessageText(
      "✅ Заявка подтверждена.\nНачислено: " + request.coins + " монет."
    );
  } catch (error) {
    await client.query("ROLLBACK");
    console.error(error);
    await ctx.answerCbQuery("Ошибка подтверждения");
  } finally {
    client.release();
  }
});

bot.action(/^reject_(.+)$/, async (ctx) => {
  if (!isAdmin(ctx)) return ctx.answerCbQuery("Нет доступа");

  try {
    const result = await pool.query(
      "DELETE FROM topup_requests WHERE id = $1 RETURNING id",
      [ctx.match[1]]
    );

    if (!result.rows.length) {
      return ctx.answerCbQuery("Заявка уже обработана");
    }

    await ctx.answerCbQuery("Заявка отклонена");
    await ctx.editMessageText("❌ Заявка отклонена.");
  } catch (error) {
    await ctx.answerCbQuery("Ошибка");
  }
});

// Запуск сервера и бота

async function start() {
  await initDatabase();

  app.listen(PORT, () => {
    console.log("Brainrot Empire started on port " + PORT);
  });

  await bot.launch();
  console.log("Telegram bot started");
}

process.once("SIGINT", () => bot.stop("SIGINT"));
process.once("SIGTERM", () => bot.stop("SIGTERM"));

start().catch(error => {
  console.error("Startup error:", error);
  process.exit(1);
});


