
const express = require("express");
const { Pool } = require("pg");
const { Telegraf, Markup } = require("telegraf");

const app = express();
app.use(express.json());

const PORT = process.env.PORT || 3000;
const BOT_TOKEN = process.env.BOT_TOKEN;
const ADMIN_TELEGRAM_ID = process.env.ADMIN_TELEGRAM_ID;
const ADMIN_PASSWORD = process.env.ADMIN_PASSWORD;

const pool = new Pool({
  connectionString: process.env.DATABASE_URL,
  ssl: process.env.DATABASE_URL
    ? { rejectUnauthorized: false }
    : false
});

const bot = BOT_TOKEN ? new Telegraf(BOT_TOKEN) : null;

const ITEMS = [
  { name: "Cash or Card", price: 45 },
  { name: "Garama and Madundung", price: 50 },
  { name: "Fragola la la la", price: 75 },
  { name: "Capitano Moby", price: 100 },
  { name: "Celestial Pegasus", price: 110 },
  { name: "Rosey and Teddy", price: 500 },
  { name: "Bumbutron", price: 600 },
  { name: "Dragon Caneloni", price: 975 }
];

const CASES = {
  starter: { price: 50, rewards: [10, 25, 50, 100] },
  premium: { price: 200, rewards: [50, 100, 250, 500] },
  royal: { price: 500, rewards: [100, 250, 500, 1000] }
};

async function initDatabase() {
  await pool.query(`
    CREATE TABLE IF NOT EXISTS players (
      id TEXT PRIMARY KEY,
      username TEXT NOT NULL,
      balance INTEGER NOT NULL DEFAULT 0,
      free_case_at TIMESTAMPTZ
    )
  `);

  await pool.query(`
    ALTER TABLE players
    ADD COLUMN IF NOT EXISTS free_case_at TIMESTAMPTZ
  `);

  await pool.query(`
    CREATE TABLE IF NOT EXISTS topup_requests (
      id TEXT PRIMARY KEY,
      player_id TEXT NOT NULL,
      player_name TEXT NOT NULL,
      roblox_username TEXT NOT NULL,
      brainrot TEXT NOT NULL,
      coins INTEGER NOT NULL,
      created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
      status TEXT NOT NULL DEFAULT 'pending'
    )
  `);

  await pool.query(`
    CREATE TABLE IF NOT EXISTS case_history (
      id SERIAL PRIMARY KEY,
      player_id TEXT NOT NULL,
      case_name TEXT NOT NULL,
      reward INTEGER NOT NULL,
      created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
    )
  `);
}

function getPlayerId(req) {
  return req.headers["x-player-id"];
}

function adminOnly(req, res, next) {
  if (
    !ADMIN_PASSWORD ||
    req.headers["x-admin-password"] !== ADMIN_PASSWORD
  ) {
    return res.status(403).json({ error: "Нет доступа" });
  }
  next();
}

function randomReward(rewards) {
  return rewards[Math.floor(Math.random() * rewards.length)];
}

async function notifyAdmin(message, keyboard) {
  if (!bot || !ADMIN_TELEGRAM_ID) return;

  try {
    await bot.telegram.sendMessage(
      ADMIN_TELEGRAM_ID,
      message,
      keyboard || {}
    );
  } catch (error) {
    console.error("Ошибка уведомления Telegram:", error.message);
  }
}

app.post("/api/register", async (req, res) => {
  try {
    const username = String(req.body.username || "").trim();

    if (username.length < 3 || username.length > 20) {
      return res.status(400).json({ error: "Имя должно быть от 3 до 20 символов" });
    }

    const id = require("crypto").randomUUID();

    await pool.query(
      "INSERT INTO players (id, username) VALUES ($1, $2)",
      [id, username]
    );

    res.json({ id, username, balance: 0 });
  } catch (error) {
    console.error(error);
    res.status(500).json({ error: "Ошибка регистрации" });
  }
});

app.get("/api/profile", async (req, res) => {
  try {
    const id = getPlayerId(req);
    if (!id) return res.status(401).json({ error: "Нет ID игрока" });

    const result = await pool.query(
      "SELECT id, username, balance FROM players WHERE id = $1",
      [id]
    );

    if (!result.rows.length) {
      return res.status(404).json({ error: "Игрок не найден" });
    }

    res.json(result.rows[0]);
  } catch (error) {
    console.error(error);
    res.status(500).json({ error: "Ошибка профиля" });
  }
});

app.get("/api/items", (req, res) => {
  res.json(ITEMS);
});

app.get("/api/cases", (req, res) => {
  res.json({
    starter: { price: CASES.starter.price },
    premium: { price: CASES.premium.price },
    royal: { price: CASES.royal.price }
  });
});

app.post("/api/topups", async (req, res) => {
  const client = await pool.connect();

  try {
    const playerId = getPlayerId(req);
    const brainrot = String(req.body.brainrot || "");
    const robloxUsername = String(req.body.robloxUsername || "").trim();

    if (!playerId) {
      return res.status(401).json({ error: "Нет ID игрока" });
    }

    if (!/^[A-Za-z0-9_]{3,20}$/.test(robloxUsername)) {
      return res.status(400).json({ error: "Неверный Roblox-ник" });
    }

    const item = ITEMS.find(x => x.name === brainrot);
    if (!item) {
      return res.status(400).json({ error: "Товар не найден" });
    }

    await client.query("BEGIN");

    const player = await client.query(
      "SELECT username FROM players WHERE id = $1 FOR UPDATE",
      [playerId]
    );

    if (!player.rows.length) {
      await client.query("ROLLBACK");
      return res.status(404).json({ error: "Игрок не найден" });
    }

    const existing = await client.query(
      `SELECT id FROM topup_requests
       WHERE player_id = $1 AND status = 'pending'
       AND created_at > NOW() - INTERVAL '5 minutes'`,
      [playerId]
    );

    if (existing.rows.length) {
      await client.query("ROLLBACK");
      return res.status(400).json({
        error: "У тебя уже есть активная заявка"
      });
    }

    const id = require("crypto").randomUUID();

    await client.query(
      `INSERT INTO topup_requests
       (id, player_id, player_name, roblox_username, brainrot, coins)
       VALUES ($1, $2, $3, $4, $5, $6)`,
      [id, playerId, player.rows[0].username,
       robloxUsername, item.name, item.price]
    );

    await client.query("COMMIT");

    await notifyAdmin(
      `🛒 НОВАЯ ЗАЯВКА\n\n` +
      `Игрок: ${player.rows[0].username}\n` +
      `Roblox: ${robloxUsername}\n` +
      `Brainrot: ${item.name}\n` +
      `Цена: ${item.price} монет\n\n` +
      `ID: ${id}`,
      Markup.inlineKeyboard([
        [Markup.button.callback("✅ Подтвердить", `approve_${id}`)],
        [Markup.button.callback("❌ Отклонить", `reject_${id}`)]
      ])
    );

    res.json({
      id,
      recipient: "Timurrrrrr125",
      expiresIn: 300
    });
  } catch (error) {
    await client.query("ROLLBACK").catch(() => {});
    console.error(error);
    res.status(500).json({ error: "Ошибка создания заявки" });
  } finally {
    client.release();
  }
});

