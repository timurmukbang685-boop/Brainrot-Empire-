
const express = require("express");
const { Pool } = require("pg");
const { Telegraf, Markup } = require("telegraf");

const app = express();
app.use(express.json());

const PORT = process.env.PORT || 3000;
const BOT_TOKEN = process.env.BOT_TOKEN;
const ADMIN_TELEGRAM_ID = process.env.ADMIN_TELEGRAM_ID;
const ADMIN_PASSWORD = process.env.ADMIN_PASSWORD;

const pool = new Pool({
  connectionString: process.env.DATABASE_URL,
  ssl: process.env.DATABASE_URL
    ? { rejectUnauthorized: false }
    : false
});

const bot = BOT_TOKEN ? new Telegraf(BOT_TOKEN) : null;

const ITEMS = [
  { name: "Cash or Card", price: 45 },
  { name: "Garama and Madundung", price: 50 },
  { name: "Fragola la la la", price: 75 },
  { name: "Capitano Moby", price: 100 },
  { name: "Celestial Pegasus", price: 110 },
  { name: "Rosey and Teddy", price: 500 },
  { name: "Bumbutron", price: 600 },
  { name: "Dragon Caneloni", price: 975 }
];

const CASES = {
  starter: { price: 50, rewards: [10, 25, 50, 100] },
  premium: { price: 200, rewards: [50, 100, 250, 500] },
  royal: { price: 500, rewards: [100, 250, 500, 1000] }
};

async function initDatabase() {
  await pool.query(`
    CREATE TABLE IF NOT EXISTS players (
      id TEXT PRIMARY KEY,
      username TEXT NOT NULL,
      balance INTEGER NOT NULL DEFAULT 0,
      free_case_at TIMESTAMPTZ
    )
  `);

  await pool.query(`
    ALTER TABLE players
    ADD COLUMN IF NOT EXISTS free_case_at TIMESTAMPTZ
  `);

  await pool.query(`
    CREATE TABLE IF NOT EXISTS topup_requests (
      id TEXT PRIMARY KEY,
      player_id TEXT NOT NULL,
      player_name TEXT NOT NULL,
      roblox_username TEXT NOT NULL,
      brainrot TEXT NOT NULL,
      coins INTEGER NOT NULL,
      created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
      status TEXT NOT NULL DEFAULT 'pending'
    )
  `);

  await pool.query(`
    CREATE TABLE IF NOT EXISTS case_history (
      id SERIAL PRIMARY KEY,
      player_id TEXT NOT NULL,
      case_name TEXT NOT NULL,
      reward INTEGER NOT NULL,
      created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
    )
  `);
}

function getPlayerId(req) {
  return req.headers["x-player-id"];
}

function adminOnly(req, res, next) {
  if (
    !ADMIN_PASSWORD ||
    req.headers["x-admin-password"] !== ADMIN_PASSWORD
  ) {
    return res.status(403).json({ error: "Нет доступа" });
  }
  next();
}

function randomReward(rewards) {
  return rewards[Math.floor(Math.random() * rewards.length)];
}

async function notifyAdmin(message, keyboard) {
  if (!bot || !ADMIN_TELEGRAM_ID) return;

  try {
    await bot.telegram.sendMessage(
      ADMIN_TELEGRAM_ID,
      message,
      keyboard || {}
    );
  } catch (error) {
    console.error("Ошибка уведомления Telegram:", error.message);
  }
}

app.post("/api/register", async (req, res) => {
  try {
    const username = String(req.body.username || "").trim();

    if (username.length < 3 || username.length > 20) {
      return res.status(400).json({ error: "Имя должно быть от 3 до 20 символов" });
    }

    const id = require("crypto").randomUUID();

    await pool.query(
      "INSERT INTO players (id, username) VALUES ($1, $2)",
      [id, username]
    );

    res.json({ id, username, balance: 0 });
  } catch (error) {
    console.error(error);
    res.status(500).json({ error: "Ошибка регистрации" });
  }
});

app.get("/api/profile", async (req, res) => {
  try {
    const id = getPlayerId(req);
    if (!id) return res.status(401).json({ error: "Нет ID игрока" });

    const result = await pool.query(
      "SELECT id, username, balance FROM players WHERE id = $1",
      [id]
    );

    if (!result.rows.length) {
      return res.status(404).json({ error: "Игрок не найден" });
    }

    res.json(result.rows[0]);
  } catch (error) {
    console.error(error);
    res.status(500).json({ error: "Ошибка профиля" });
  }
});

app.get("/api/items", (req, res) => {
  res.json(ITEMS);
});

app.get("/api/cases", (req, res) => {
  res.json({
    starter: { price: CASES.starter.price },
    premium: { price: CASES.premium.price },
    royal: { price: CASES.royal.price }
  });
});

app.post("/api/topups", async (req, res) => {
  const client = await pool.connect();

  try {
    const playerId = getPlayerId(req);
    const brainrot = String(req.body.brainrot || "");
    const robloxUsername = String(req.body.robloxUsername || "").trim();

    if (!playerId) {
      return res.status(401).json({ error: "Нет ID игрока" });
    }

    if (!/^[A-Za-z0-9_]{3,20}$/.test(robloxUsername)) {
      return res.status(400).json({ error: "Неверный Roblox-ник" });
    }

    const item = ITEMS.find(x => x.name === brainrot);
    if (!item) {
      return res.status(400).json({ error: "Товар не найден" });
    }

    await client.query("BEGIN");

    const player = await client.query(
      "SELECT username FROM players WHERE id = $1 FOR UPDATE",
      [playerId]
    );

    if (!player.rows.length) {
      await client.query("ROLLBACK");
      return res.status(404).json({ error: "Игрок не найден" });
    }

    const existing = await client.query(
      `SELECT id FROM topup_requests
       WHERE player_id = $1 AND status = 'pending'
       AND created_at > NOW() - INTERVAL '5 minutes'`,
      [playerId]
    );

    if (existing.rows.length) {
      await client.query("ROLLBACK");
      return res.status(400).json({
        error: "У тебя уже есть активная заявка"
      });
    }

    const id = require("crypto").randomUUID();

    await client.query(
      `INSERT INTO topup_requests
       (id, player_id, player_name, roblox_username, brainrot, coins)
       VALUES ($1, $2, $3, $4, $5, $6)`,
      [id, playerId, player.rows[0].username,
       robloxUsername, item.name, item.price]
    );

    await client.query("COMMIT");

    await notifyAdmin(
      `🛒 НОВАЯ ЗАЯВКА\n\n` +
      `Игрок: ${player.rows[0].username}\n` +
      `Roblox: ${robloxUsername}\n` +
      `Brainrot: ${item.name}\n` +
      `Цена: ${item.price} монет\n\n` +
      `ID: ${id}`,
      Markup.inlineKeyboard([
        [Markup.button.callback("✅ Подтвердить", `approve_${id}`)],
        [Markup.button.callback("❌ Отклонить", `reject_${id}`)]
      ])
    );

    res.json({
      id,
      recipient: "Timurrrrrr125",
      expiresIn: 300
    });
  } catch (error) {
    await client.query("ROLLBACK").catch(() => {});
    console.error(error);
    res.status(500).json({ error: "Ошибка создания заявки" });
  } finally {
    client.release();
  }
});


app.get("/api/cases/free/status", async (req, res) => {
  try {
    const id = getPlayerId(req);
    if (!id) return res.status(401).json({ error: "Нет ID игрока" });

    const result = await pool.query(
      "SELECT free_case_at FROM players WHERE id = $1",
      [id]
    );

    if (!result.rows.length) {
      return res.status(404).json({ error: "Игрок не найден" });
    }

    const last = result.rows[0].free_case_at;
    const next = last
      ? new Date(new Date(last).getTime() + 12 * 60 * 60 * 1000)
      : null;

    const remainingSeconds = next
      ? Math.max(0, Math.ceil((next.getTime() - Date.now()) / 1000))
      : 0;

    res.json({
      available: remainingSeconds === 0,
      nextAvailableAt: next,
      remainingSeconds
    });
  } catch (error) {
    console.error(error);
    res.status(500).json({ error: "Ошибка бесплатного кейса" });
  }
});

app.post("/api/cases/free/open", async (req, res) => {
  const client = await pool.connect();

  try {
    const id = getPlayerId(req);
    if (!id) return res.status(401).json({ error: "Нет ID игрока" });

    await client.query("BEGIN");

    const result = await client.query(
      "SELECT balance, free_case_at FROM players WHERE id = $1 FOR UPDATE",
      [id]
    );

    if (!result.rows.length) {
      await client.query("ROLLBACK");
      return res.status(404).json({ error: "Игрок не найден" });
    }

    const last = result.rows[0].free_case_at;

    if (
      last &&
      Date.now() - new Date(last).getTime() < 12 * 60 * 60 * 1000
    ) {
      await client.query("ROLLBACK");
      return res.status(400).json({
        error: "Бесплатный кейс ещё недоступен"
      });
    }

    await client.query(
      `UPDATE players
       SET balance = balance + 2, free_case_at = NOW()
       WHERE id = $1`,
      [id]
    );

    await client.query("COMMIT");

    const updated = await pool.query(
      "SELECT balance, free_case_at FROM players WHERE id = $1",
      [id]
    );

    res.json({
      reward: 2,
      balance: updated.rows[0].balance,
      nextAvailableAt: new Date(
        new Date(updated.rows[0].free_case_at).getTime() +
        12 * 60 * 60 * 1000
      )
    });
  } catch (error) {
    await client.query("ROLLBACK").catch(() => {});
    console.error(error);
    res.status(500).json({ error: "Ошибка открытия кейса" });
  } finally {
    client.release();
  }
});

app.post("/api/cases/open", async (req, res) => {
  const client = await pool.connect();

  try {
    const id = getPlayerId(req);
    const caseName = req.body.case;
    const selectedCase = CASES[caseName];

    if (!id) return res.status(401).json({ error: "Нет ID игрока" });
    if (!selectedCase) {
      return res.status(400).json({ error: "Кейс не найден" });
    }

    await client.query("BEGIN");

    const result = await client.query(
      "SELECT balance FROM players WHERE id = $1 FOR UPDATE",
      [id]
    );

    if (!result.rows.length) {
      await client.query("ROLLBACK");
      return res.status(404).json({ error: "Игрок не найден" });
    }

    if (result.rows[0].balance < selectedCase.price) {
      await client.query("ROLLBACK");
      return res.status(400).json({ error: "Недостаточно монет" });
    }

    const reward = randomReward(selectedCase.rewards);

    await client.query(
      "UPDATE players SET balance = balance - $1 + $2 WHERE id = $3",
      [selectedCase.price, reward, id]
    );

    await client.query(
      "INSERT INTO case_history (player_id, case_name, reward) VALUES ($1, $2, $3)",
      [id, caseName, reward]
    );

    await client.query("COMMIT");

    const updated = await pool.query(
      "SELECT balance FROM players WHERE id = $1",
      [id]
    );

    res.json({ reward, balance: updated.rows[0].balance });
  } catch (error) {
    await client.query("ROLLBACK").catch(() => {});
    console.error(error);
    res.status(500).json({ error: "Ошибка открытия кейса" });
  } finally {
    client.release();
  }
});

if (bot) {
  bot.action(/^approve_(.+)$/, async (ctx) => {
    if (String(ctx.from.id) !== String(ADMIN_TELEGRAM_ID)) {
      return ctx.answerCbQuery("Нет доступа");
    }

    const id = ctx.match[1];
    const client = await pool.connect();

    try {
      await client.query("BEGIN");

      const result = await client.query(
        `SELECT * FROM topup_requests
         WHERE id = $1 AND status = 'pending'
         AND created_at > NOW() - INTERVAL '5 minutes'
         FOR UPDATE`,
        [id]
      );

      if (!result.rows.length) {
        await client.query("ROLLBACK");
        return ctx.answerCbQuery("Заявка не найдена или истекла");
      }

      const request = result.rows[0];

      await client.query(
        "UPDATE players SET balance = balance + $1 WHERE id = $2",
        [request.coins, request.player_id]
      );

      await client.query(
        "UPDATE topup_requests SET status = 'approved' WHERE id = $1",
        [id]
      );

      await client.query("COMMIT");

      await ctx.editMessageText(
        `✅ Заявка подтверждена!\nИгрок: ${request.player_name}\nНачислено: ${request.coins} монет`
      );

      await ctx.answerCbQuery("Подтверждено");
    } catch (error) {
      await client.query("ROLLBACK").catch(() => {});
      console.error(error);
      await ctx.answerCbQuery("Ошибка");
    } finally {
      client.release();
    }
  });

  bot.action(/^reject_(.+)$/, async (ctx) => {
    if (String(ctx.from.id) !== String(ADMIN_TELEGRAM_ID)) {
      return ctx.answerCbQuery("Нет доступа");
    }

    const id = ctx.match[1];

    try {
      const result = await pool.query(
        `UPDATE topup_requests
         SET status = 'rejected'
         WHERE id = $1 AND status = 'pending'
         RETURNING player_name`,
        [id]
      );

      if (!result.rows.length) {
        return ctx.answerCbQuery("Заявка не найдена");
      }

      await ctx.editMessageText(
        `❌ Заявка отклонена\nИгрок: ${result.rows[0].player_name}`
      );

      await ctx.answerCbQuery("Отклонено");
    } catch (error) {
      console.error(error);
      await ctx.answerCbQuery("Ошибка");
    }
  });

  bot.catch((error) => console.error("Ошибка бота:", error));

  bot.launch().catch(error =>
    console.error("Не удалось запустить Telegram-бота:", error)
  );
}

