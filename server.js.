app.post("/api/topups", async (req, res) => {
  const client = await pool.connect();

  try {
    const playerId = getPlayerId(req);
    const brainrot = String(req.body.brainrot || "");
    const robloxUsername = String(req.body.robloxUsername || "").trim();

    if (!playerId) {
      return res.status(401).json({ error: "Нет ID игрока" });
    }

    if (!/^[A-Za-z0-9_]{3,20}$/.test(robloxUsername)) {
      return res.status(400).json({ error: "Неверный Roblox-ник" });
    }

    const item = ITEMS.find(x => x.name === brainrot);

    if (!item) {
      return res.status(400).json({ error: "Товар не найден" });
    }

    const player = await client.query(
      "SELECT username FROM players WHERE id = $1",
      [playerId]
    );

    if (!player.rows.length) {
      return res.status(404).json({ error: "Игрок не найден" });
    }

    const existing = await client.query(
      `SELECT id FROM topup_requests
       WHERE player_id = $1
       AND status = 'pending'
       AND created_at > NOW() - INTERVAL '5 minutes'`,
      [playerId]
    );

    if (existing.rows.length) {
      return res.status(400).json({
        error: "У тебя уже есть активная заявка"
      });
    }

    const id = crypto.randomUUID();

    await client.query(
      `INSERT INTO topup_requests
       (id, player_id, player_name, roblox_username, brainrot, coins)
       VALUES ($1, $2, $3, $4, $5, $6)`,
      [
        id,
        playerId,
        player.rows[0].username,
        robloxUsername,
        item.name,
        item.price
      ]
    );

    await notifyAdmin(
      `🛒 НОВАЯ ЗАЯВКА

Игрок: ${player.rows[0].username}
Roblox: ${robloxUsername}
Brainrot: ${item.name}
Цена: ${item.price} монет

ID: ${id}`,
      {
        ...Markup.inlineKeyboard([
          [Markup.button.callback("✅ Подтвердить", `approve_${id}`)],
          [Markup.button.callback("❌ Отклонить", `reject_${id}`)]
        ])
      }
    );

    res.json({
      id,
      recipient: "Timurrrrrr125",
      expiresIn: 300
    });
  } catch (error) {
    console.error(error);
    res.status(500).json({ error: "Ошибка создания заявки" });
  } finally {
    client.release();
  }
});
app.get("/api/cases/free/status", async (req, res) => {
  try {
    const id = getPlayerId(req);

    if (!id) {
      return res.status(401).json({ error: "Нет ID игрока" });
    }

    const result = await pool.query(
      "SELECT free_case_at FROM players WHERE id = $1",
      [id]
    );

    if (!result.rows.length) {
      return res.status(404).json({ error: "Игрок не найден" });
    }

    const last = result.rows[0].free_case_at;
    const next = last
      ? new Date(new Date(last).getTime() + 12 * 60 * 60 * 1000)
      : null;

    const remainingSeconds = next
      ? Math.max(0, Math.ceil((next.getTime() - Date.now()) / 1000))
      : 0;

    res.json({
      available: remainingSeconds === 0,
      nextAvailableAt: next,
      remainingSeconds
    });
  } catch (error) {
    console.error(error);
    res.status(500).json({ error: "Ошибка бесплатного кейса" });
  }
});

app.post("/api/cases/free/open", async (req, res) => {
  const client = await pool.connect();

  try {
    const id = getPlayerId(req);

    if (!id) {
      return res.status(401).json({ error: "Нет ID игрока" });
    }

    await client.query("BEGIN");

    const result = await client.query(
      "SELECT id, free_case_at FROM players WHERE id = $1 FOR UPDATE",
      [id]
    );

    if (!result.rows.length) {
      await client.query("ROLLBACK");
      return res.status(404).json({ error: "Игрок не найден" });
    }

    const last = result.rows[0].free_case_at;

    if (
      last &&
      Date.now() - new Date(last).getTime() < 12 * 60 * 60 * 1000
    ) {
      await client.query("ROLLBACK");
      return res.status(400).json({
        error: "Бесплатный кейс пока недоступен"
      });
    }

    await client.query(
      `UPDATE players
       SET balance = balance + 2, free_case_at = NOW()
       WHERE id = $1`,
      [id]
    );

    await client.query("COMMIT");

    res.json({
      reward: 2,
      message: "Ты получил 2 монеты!"
    });
  } catch (error) {
    await client.query("ROLLBACK").catch(() => {});
    console.error(error);
    res.status(500).json({ error: "Ошибка открытия кейса" });
  } finally {
    client.release();
  }
});

app.post("/api/cases/open", async (req, res) => {
  const client = await pool.connect();

  try {
    const id = getPlayerId(req);
    const caseName = String(req.body.caseName || "");
    const selectedCase = CASES[caseName];

    if (!id) {
      return res.status(401).json({ error: "Нет ID игрока" });
    }

    if (!selectedCase) {
      return res.status(400).json({ error: "Кейс не найден" });
    }

    await client.query("BEGIN");

    const result = await client.query(
      "SELECT balance FROM players WHERE id = $1 FOR UPDATE",
      [id]
    );

    if (!result.rows.length) {
      await client.query("ROLLBACK");
      return res.status(404).json({ error: "Игрок не найден" });
    }

    if (result.rows[0].balance < selectedCase.price) {
      await client.query("ROLLBACK");
      return res.status(400).json({ error: "Недостаточно монет" });
    }

    const reward = randomReward(selectedCase.rewards);

    await client.query(
      "UPDATE players SET balance = balance - $1 + $2 WHERE id = $3",
      [selectedCase.price, reward, id]
    );

    await client.query(
      `INSERT INTO case_history (player_id, case_name, reward)
       VALUES ($1, $2, $3)`,
      [id, caseName, reward]
    );

    await client.query("COMMIT");

    res.json({
      reward,
      caseName,
      message: `Ты выиграл ${reward} монет!`
    });
  } catch (error) {
    await client.query("ROLLBACK").catch(() => {});
    console.error(error);
    res.status(500).json({ error: "Ошибка открытия кейса" });
  } finally {
    client.release();
  }
});
if (bot) {
  bot.action(/^approve_(.+)$/, async (ctx) => {
    const id = ctx.match[1];

    try {
      const result = await pool.query(
        `UPDATE topup_requests
         SET status = 'approved'
         WHERE id = $1 AND status = 'pending'
         RETURNING player_id, player_name, brainrot`,
        [id]
      );

      if (!result.rows.length) {
        return ctx.answerCbQuery("Заявка уже обработана");
      }

      await ctx.editMessageText(
        `✅ Заявка подтверждена!\nИгрок: ${result.rows[0].player_name}\nBrainrot: ${result.rows[0].brainrot}`
      );

      await ctx.answerCbQuery("Подтверждено");
    } catch (error) {
      console.error(error);
      await ctx.answerCbQuery("Ошибка");
    }
  });

  bot.action(/^reject_(.+)$/, async (ctx) => {
    const id = ctx.match[1];

    try {
      const result = await pool.query(
        `UPDATE topup_requests
         SET status = 'rejected'
         WHERE id = $1 AND status = 'pending'
         RETURNING player_name`,
        [id]
      );

      if (!result.rows.length) {
        return ctx.answerCbQuery("Заявка уже обработана");
      }

      await ctx.editMessageText(
        `❌ Заявка отклонена!\nИгрок: ${result.rows[0].player_name}`
      );

      await ctx.answerCbQuery("Отклонено");
    } catch (error) {
      console.error(error);
      await ctx.answerCbQuery("Ошибка");
    }
  });

  bot.launch().catch(error => {
    console.error("Telegram bot error:", error);
  });
}

