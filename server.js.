
const express = require("express");
const { Telegraf, Markup } = require("telegraf");
const cors = require("cors");
const { Pool } = require("pg");
const crypto = require("crypto");

const app = express();

app.use(cors());
app.use(express.json());

const PORT = process.env.PORT || 3000;
const BOT_TOKEN = process.env.BOT_TOKEN;
const ADMIN_ID = process.env.ADMIN_TELEGRAM_ID;
const ADMIN_PASSWORD = process.env.ADMIN_PASSWORD;

if (!process.env.DATABASE_URL) {
  throw new Error("DATABASE_URL is missing");
}

if (!BOT_TOKEN) {
  throw new Error("BOT_TOKEN is missing");
}

const pool = new Pool({
  connectionString: process.env.DATABASE_URL,
  ssl: { rejectUnauthorized: false }
});

const bot = new Telegraf(BOT_TOKEN);

const ITEMS = {
  "Cash or Card": 45,
  "Garama and Madundung": 50,
  "Fragola la la la": 75,
  "Capitano Moby": 100,
  "Celestial Pegasus": 110,
  "Rosey and Teddy": 500,
  "Bumbutron": 600,
  "Dragon Caneloni": 975
};

const CASES = {
  starter: { price: 50, rewards: [10, 25, 50, 100] },
  premium: { price: 200, rewards: [50, 100, 250, 500] },
  royal: { price: 500, rewards: [100, 250, 500, 1000] }
};

async function initDatabase() {
  await pool.query(`
    CREATE TABLE IF NOT EXISTS players (
      id TEXT PRIMARY KEY,
      username TEXT NOT NULL,
      balance INTEGER NOT NULL DEFAULT 0
    );

    CREATE TABLE IF NOT EXISTS topup_requests (
      id TEXT PRIMARY KEY,
      player_id TEXT NOT NULL REFERENCES players(id) ON DELETE CASCADE,
      player_name TEXT NOT NULL,
      brainrot TEXT NOT NULL,
      coins INTEGER NOT NULL,
      created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
    );

    CREATE TABLE IF NOT EXISTS case_history (
      id TEXT PRIMARY KEY,
      player_id TEXT NOT NULL REFERENCES players(id) ON DELETE CASCADE,
      case_name TEXT NOT NULL,
      reward INTEGER NOT NULL,
      created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
    );
  `);
}

function getPlayerId(req) {
  const id = req.get("x-player-id");
  return id && /^[a-f0-9-]{36}$/i.test(id) ? id : null;
}

function adminOnly(req, res, next) {
  if (!ADMIN_PASSWORD ||
      req.get("x-admin-password") !== ADMIN_PASSWORD) {
    return res.status(401).json({ error: "Admin access denied" });
  }
  next();
}

function isAdmin(ctx) {
  return ADMIN_ID &&
    String(ctx.from.id) === String(ADMIN_ID);
}

async function notifyAdmin(message, extra = {}) {
  if (!ADMIN_ID) return;
  try {
    await bot.telegram.sendMessage(ADMIN_ID, message, extra);
  } catch (error) {
    console.error("Admin notification failed:", error.message);
  }
}

app.get("/", (req, res) => {
  res.send("Brainrot Empire server is running!");
});

app.post("/api/register", async (req, res) => {
  try {
    const username = String(req.body.username || "").trim();

    if (!/^[A-Za-z0-9_]{3,20}$/.test(username)) {
      return res.status(400).json({ error: "Invalid username" });
    }

    const id = crypto.randomUUID();

    await pool.query(
      "INSERT INTO players (id, username) VALUES ($1, $2)",
      [id, username]
    );

    res.status(201).json({
      id,
      username,
      balance: 0
    });
  } catch (error) {
    console.error(error);
    res.status(500).json({ error: "Registration failed" });
  }
});

app.get("/api/profile", async (req, res) => {
  const id = getPlayerId(req);

  if (!id) {
    return res.status(401).json({ error: "Player ID required" });
  }

  try {
    const result = await pool.query(
      "SELECT username, balance FROM players WHERE id = $1",
      [id]
    );

    if (!result.rows.length) {
      return res.status(404).json({ error: "Player not found" });
    }

    res.json(result.rows[0]);
  } catch (error) {
    console.error(error);
    res.status(500).json({ error: "Database error" });
  }
});

app.get("/api/items", (req, res) => {
  res.json(ITEMS);
});

app.post("/api/topups", async (req, res) => {
  const id = getPlayerId(req);

  if (!id) {
    return res.status(401).json({ error: "Register first" });
  }

  try {
    const brainrot = String(req.body.brainrot || "");
    const playerName = String(req.body.robloxUsername || "").trim();

    if (!Object.prototype.hasOwnProperty.call(ITEMS, brainrot)) {
      return res.status(400).json({ error: "Invalid Brainrot" });
    }

    if (!/^[A-Za-z0-9_]{3,20}$/.test(playerName)) {
      return res.status(400).json({ error: "Invalid Roblox username" });
    }

    const pending = await pool.query(
      "SELECT id FROM topup_requests WHERE player_id = $1",
      [id]
    );

    if (pending.rows.length) {
      return res.status(409).json({
        error: "You already have a pending request"
      });
    }

    const requestId = crypto.randomUUID();

    await pool.query(
      `INSERT INTO topup_requests
       (id, player_id, player_name, brainrot, coins)
       VALUES ($1, $2, $3, $4, $5)`,
      [requestId, id, playerName, brainrot, ITEMS[brainrot]]
    );

    const message =
      "Новая заявка Brainrot Empire\n" +
      "Игрок: " + playerName + "\n" +
      "Brainrot: " + brainrot + "\n" +
      "Монеты: " + ITEMS[brainrot] + "\n" +
      "ID: " + requestId;

    await notifyAdmin(message);

    res.status(201).json({
      id: requestId,
      brainrot,
      coins: ITEMS[brainrot],
      recipient: "Timurrrrrr125",
      expiresIn: 300
    });
  } catch (error) {
    console.error(error);
    res.status(500).json({ error: "Could not create request" });
  }
});

app.post("/api/cases/open", async (req, res) => {
  const id = getPlayerId(req);

  if (!id) {
    return res.status(401).json({ error: "Register first" });
  }

  const caseName = String(req.body.case || "");
  const selectedCase = CASES[caseName];

  if (!selectedCase) {
    return res.status(400).json({ error: "Invalid case" });
  }

  const client = await pool.connect();

  try {
    await client.query("BEGIN");

    const player = await client.query(
      "SELECT balance FROM players WHERE id = $1 FOR UPDATE",
      [id]
    );

    if (!player.rows.length) {
      await client.query("ROLLBACK");
      return res.status(404).json({ error: "Player not found" });
    }

    if (player.rows[0].balance < selectedCase.price) {
      await client.query("ROLLBACK");
      return res.status(400).json({ error: "Not enough coins" });
    }

    const rewards = selectedCase.rewards;
    const reward = rewards[crypto.randomInt(rewards.length)];

    await client.query(
      `UPDATE players
       SET balance = balance - $1 + $2
       WHERE id = $3`,
      [selectedCase.price, reward, id]
    );

    await client.query(
      `INSERT INTO case_history
       (id, player_id, case_name, reward)
       VALUES ($1, $2, $3, $4)`,
      [crypto.randomUUID(), id, caseName, reward]
    );

    const updated = await client.query(
      "SELECT balance FROM players WHERE id = $1",
      [id]
    );

    await client.query("COMMIT");

    res.json({
      case: caseName,
      spent: selectedCase.price,
      reward,
      balance: updated.rows[0].balance
    });
  } catch (error) {
    await client.query("ROLLBACK");
    console.error(error);
    res.status(500).json({ error: "Could not open case" });
  } finally {
    client.release();
  }
});

app.get("/api/cases", (req, res) => {
