function getPlayerId(req) {
  return req.headers["x-player-id"];
}

function randomReward(rewards) {
  return rewards[Math.floor(Math.random() * rewards.length)];
}

async function initDatabase() {
  await pool.query(`
    CREATE TABLE IF NOT EXISTS players (
      id TEXT PRIMARY KEY,
      username TEXT NOT NULL,
      balance INTEGER NOT NULL DEFAULT 0,
      free_case_at TIMESTAMPTZ
    )
  `);

  await pool.query(`
    ALTER TABLE players
    ADD COLUMN IF NOT EXISTS free_case_at TIMESTAMPTZ
  `);

  await pool.query(`
    CREATE TABLE IF NOT EXISTS topup_requests (
      id TEXT PRIMARY KEY,
      player_id TEXT NOT NULL,
      player_name TEXT NOT NULL,
      roblox_username TEXT NOT NULL DEFAULT '',
      brainrot TEXT NOT NULL,
      coins INTEGER NOT NULL,
      created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
      status TEXT NOT NULL DEFAULT 'pending'
    )
  `);

  await pool.query(`
    ALTER TABLE topup_requests
    ADD COLUMN IF NOT EXISTS roblox_username TEXT NOT NULL DEFAULT ''
  `);

  await pool.query(`
    ALTER TABLE topup_requests
    ADD COLUMN IF NOT EXISTS status TEXT NOT NULL DEFAULT 'pending'
  `);

  await pool.query(`
    CREATE TABLE IF NOT EXISTS case_history (
      id SERIAL PRIMARY KEY,
      player_id TEXT NOT NULL,
      case_name TEXT NOT NULL,
      reward INTEGER NOT NULL,
      created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
    )
  `);
}

async function notifyAdmin(message, keyboard) {
  if (!bot || !ADMIN_TELEGRAM_ID) return;

  try {
    await bot.telegram.sendMessage(
      ADMIN_TELEGRAM_ID,
      message,
      keyboard || {}
    );
  } catch (error) {
    console.error("Telegram error:", error.message);
  }
}
app.post("/api/register", async (req, res) => {
  try {
    const username = String(req.body.username || "").trim();

    if (!/^[A-Za-zА-Яа-яЁё0-9_]{3,20}$/.test(username)) {
      return res.status(400).json({
        error: "Имя должно содержать от 3 до 20 символов"
      });
    }

    const id = crypto.randomUUID();

    await pool.query(
      "INSERT INTO players (id, username, balance) VALUES ($1, $2, 0)",
      [id, username]
    );

    res.json({ id, username, balance: 0 });
  } catch (error) {
    console.error(error);
    res.status(500).json({ error: "Ошибка регистрации" });
  }
});

app.get("/api/profile", async (req, res) => {
  try {
    const id = getPlayerId(req);

    if (!id) {
      return res.status(401).json({ error: "Нет ID игрока" });
    }

    const result = await pool.query(
      "SELECT id, username, balance FROM players WHERE id = $1",
      [id]
    );

    if (!result.rows.length) {
      return res.status(404).json({ error: "Игрок не найден" });
    }

    res.json(result.rows[0]);
  } catch (error) {
    console.error(error);
    res.status(500).json({ error: "Ошибка профиля" });
  }
});

