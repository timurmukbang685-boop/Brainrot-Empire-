app.get("/api/admin/topups", adminOnly, async (req, res) => {
  try {
    await pool.query(`
      DELETE FROM topup_requests
      WHERE created_at <= NOW() - INTERVAL '5 minutes'
    `);

    const result = await pool.query(`
      SELECT id, player_id, player_name, brainrot, coins, created_at
      FROM topup_requests
      ORDER BY created_at ASC
    `);

    res.json(result.rows);
  } catch (error) {
    res.status(500).json({ error: "Could not load requests" });
  }
});

app.post("/api/admin/topups/:id/approve", adminOnly, async (req, res) => {
  const client = await pool.connect();

  try {
    await client.query("BEGIN");

    const result = await client.query(
      "SELECT * FROM topup_requests WHERE id = $1 FOR UPDATE",
      [req.params.id]
    );

    if (!result.rows.length) {
      await client.query("ROLLBACK");
      return res.status(404).json({ error: "Request not found" });
    }

    const request = result.rows[0];

    if (Date.now() - new Date(request.created_at).getTime() >= 300000) {
      await client.query(
        "DELETE FROM topup_requests WHERE id = $1",
        [request.id]
      );
      await client.query("COMMIT");
      return res.status(410).json({ error: "Request expired" });
    }

    await client.query(
      "UPDATE players SET balance = balance + $1 WHERE id = $2",
      [request.coins, request.player_id]
    );

    await client.query(
      "DELETE FROM topup_requests WHERE id = $1",
      [request.id]
    );

    await client.query("COMMIT");

    res.json({ success: true, credited: request.coins });
  } catch (error) {
    await client.query("ROLLBACK");
    res.status(500).json({ error: "Approval failed" });
  } finally {
    client.release();
  }
});

app.post("/api/admin/topups/:id/reject", adminOnly, async (req, res) => {
  try {
    const result = await pool.query(
      "DELETE FROM topup_requests WHERE id = $1 RETURNING id",
      [req.params.id]
    );

    if (!result.rows.length) {
      return res.status(404).json({ error: "Request not found" });
    }

    res.json({ success: true });
  } catch (error) {
    res.status(500).json({ error: "Rejection failed" });
  }
});

app.get("/api/admin/players", adminOnly, async (req, res) => {
  try {
    const result = await pool.query(
      "SELECT id, username, balance FROM players ORDER BY balance DESC"
    );

    res.json(result.rows);
  } catch (error) {
    res.status(500).json({ error: "Could not load players" });
  }
});

app.post("/api/admin/players/:id/balance", adminOnly, async (req, res) => {
  const amount = Number(req.body.amount);

  if (!Number.isSafeInteger(amount) || amount === 0 || Math.abs(amount) > 1000000) {
    return res.status(400).json({ error: "Invalid amount" });
  }

  try {
    const result = await pool.query(
      `UPDATE players
       SET balance = balance + $1
       WHERE id = $2 AND balance + $1 >= 0
       RETURNING username, balance`,
      [amount, req.params.id]
    );

    if (!result.rows.length) {
      return res.status(404).json({ error: "Player not found or insufficient balance" });
    }

    res.json(result.rows[0]);
  } catch (error) {
    res.status(500).json({ error: "Balance update failed" });
  }
});

